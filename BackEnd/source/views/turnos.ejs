<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head.ejs') %>
    <link rel="stylesheet" href="/css/turnos.css">
  <title>Reservar turno</title>
</head>
<body>
    <header>

        <%- include('partials/header.ejs') %>

    </header>

<div class="page">

  <h1>Reservá tu turno</h1>
  <p class="subtitle">Seleccioná un día y horario disponible</p>

  <div id="alert-box" class="alert"></div>

  <!-- Calendario -->
  <div class="card">
    <div class="cal-nav">
      <button id="prev">&#8592;</button>
      <span id="month-label"></span>
      <button id="next">&#8594;</button>
    </div>
    <div class="cal-grid" id="cal"></div>
  </div>

  <!-- Horarios -->
  <div class="card" id="slots-card" style="display:none;">
    <p class="section-label" id="slots-title"></p>
    <div class="spinner" id="spinner-slots">Horarios Disponibles</div>
    <div class="slots" id="slots"></div>
  </div>

  <!-- Formulario -->
  <div class="formulario">
    <p class="section-label">Tus datos</p>
    <div class="form-row"><label>Nombre completo *</label><input type="text" id="inp-nombre" placeholder="Ej: María García" required/></div>
    <div class="form-row"><label>Email *</label><input type="email" id="inp-email" placeholder="tu@email.com" required/></div>
    <div class="form-row"><label>Teléfono (opcional)</label><input type="tel" id="inp-tel" placeholder="+54 11 1234-5678" /></div>
    <div class="form-row">
  <label>Tipo de sesión *</label>
  <select id="inp-tipo">
    <option value="">Seleccioná...</option>
    <option value="primera_sesion">Primera sesión</option>
    <option value="individual">Individual</option>
    <option value="grupal">Grupal</option>
  </select>
</div>
    <button class="btn-primary" id="confirm-btn">Confirmar turno</button>
  </div>

</div>
        <footer class="main-footer">
            <%- include('partials/footer.ejs') %>
          </footer>
      <script src="/js/turnos.js"></script>
</body>
</html>